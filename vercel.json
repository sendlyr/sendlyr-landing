{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/*.js": { "runtime": "nodejs24.x", "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/build/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/for/fitness", "destination": "/for/fitness-apps", "permanent": true },
    { "source": "/for/cooking", "destination": "/for/cooking-apps", "permanent": true },
    { "source": "/for/edtech", "destination": "/for/edtech-apps", "permanent": true },
    { "source": "/for/((?!fitness-apps|cooking-apps|edtech-apps).*)", "destination": "/how-it-works", "permanent": false }
  ]
}
