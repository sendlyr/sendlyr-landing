# Server-only Supabase configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-server-secret
SUPABASE_LEADS_TABLE=leads
SUPABASE_EVENTS_TABLE=analytics_events
SUPABASE_BOOKINGS_TABLE=analytics_bookings
SUPABASE_AGGREGATES_TABLE=analytics_daily
SUPABASE_SYNC_STATE_TABLE=analytics_sync_state

# Browser event ingestion stays disabled until schema, WAF, and privacy gates pass.
ANALYTICS_ENABLED=false
ANALYTICS_ENV=local
ANALYTICS_ALLOWED_ORIGINS=https://www.sendlyr.com,http://127.0.0.1:4173
ANALYTICS_ID_SECRET=replace-with-at-least-32-random-characters

# Calendly booking sync
CALENDLY_PAT=replace-with-a-personal-access-token
CALENDLY_ORGANIZATION_URI=https://api.calendly.com/organizations/replace-me
ANALYTICS_OPERATOR_ID=replace-with-an-internal-operator-id

# Dedicated hosted-test project only
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_ROLE_KEY=
SUPABASE_TEST_TABLE_PREFIX=sendlyr_test_
